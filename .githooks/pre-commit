#!/bin/sh
# Antes de cada commit: confere se witcher-wiki-dados.js está em dia com a wiki e se não há
# links quebrados, ids repetidos ou datas inconsistentes. Ativado com:
#   git config core.hooksPath .githooks
node tools/importar-wiki.js --conferir || exit 1
node tools/verificar.js || exit 1
# Carimba a versao nos scripts e no service worker (evita HTML novo com JS antigo em cache)
node tools/versionar.js && git add 'Wiki The Witcher.dc.html' sw.js || exit 1
